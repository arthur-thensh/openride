{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "*": "ask",

    "read": "allow",
    "glob": "allow",
    "grep": "allow",

    "edit": "ask",

    "bash": {
      "*": "ask",

      "git status": "allow",
      "git status --short": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git branch --show-current": "allow",

      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git clean *": "deny",
      "git checkout *": "deny",
      "git restore *": "deny",
      "rm -rf *": "deny"
    },

    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2048
  },

  "watcher": {
    "ignore": [
      ".git/**",
      "build/**",
      "vendor/**",
      "data/**"
    ]
  }
}
